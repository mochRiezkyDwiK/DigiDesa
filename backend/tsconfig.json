{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "moduleResolution": "node10",
    "ignoreDeprecations": "5.0",
    "resolveJsonModule": true,
    "noImplicitAny": false,
    "typeRoots": ["./types", "./node_modules/@types"]
  },
  "include": ["*.ts", "routes/**/*.ts", "controllers/**/*.ts", "middleware/**/*.ts", "types/**/*.d.ts"]
}
